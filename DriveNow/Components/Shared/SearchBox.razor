<div class="input-group dn-search">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input type="text"
           class="form-control"
           placeholder="@Placeholder"
           value="@Value"
           @oninput="OnInput" />
    @if (!string.IsNullOrEmpty(Value))
    {
        <button class="btn btn-outline-secondary" type="button" aria-label="Clear search" @onclick="Clear">
            <i class="bi bi-x-lg"></i>
        </button>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search...";

    private Task OnInput(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private Task Clear() => ValueChanged.InvokeAsync(string.Empty);
}