@inject AuthService AuthService
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        @{
            var name = context.User.FindFirst("DisplayName")?.Value ?? "User";
        }
        <span class="dn-avatar" title="@name">@(name.Substring(0, 1).ToUpper())</span>
        <span class="dn-username d-none d-lg-inline">@name</span>
        <button type="button" class="dn-icon-btn" title="Logout" aria-label="Logout" @onclick="LogoutAsync">
            <i class="bi bi-box-arrow-right"></i>
        </button>
    </Authorized>
</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("login", replace: true);
    }
}