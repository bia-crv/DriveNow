@inherits LayoutComponentBase
@inject ThemeService Theme
@implements IDisposable

<div class="dn-app @(Theme.IsDark ? "dn-dark" : "")">
    <AuthorizeView>
        <Authorized>
            <NavMenu />
            <main class="container-xl dn-main">
                @Body
            </main>
        </Authorized>
        <Authorizing>
            <LoadingSpinner Text="Checking your session..." />
        </Authorizing>
        <NotAuthorized>
            <RedirectToLogin />
        </NotAuthorized>
    </AuthorizeView>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => Theme.OnChange += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.OnChange -= Refresh;
}