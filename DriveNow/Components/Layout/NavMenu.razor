@inject NavigationManager Nav
@implements IDisposable

<nav class="navbar navbar-expand-md dn-navbar">
    <div class="container-xl">
        <a class="dn-logo" href="">
            <span class="dn-logo-mark"><i class="bi bi-lightning-charge-fill"></i></span>
            DRIVENOW
        </a>

        <button class="navbar-toggler dn-toggler" type="button" aria-label="Toggle navigation" @onclick="ToggleMenu">
            <i class="bi @(menuOpen ? "bi-x-lg" : "bi-list")"></i>
        </button>

        <div class="collapse navbar-collapse @(menuOpen ? "show" : "")">
            <ul class="navbar-nav mx-auto gap-md-1">
                <li class="nav-item">
                    <NavLink class="nav-link dn-nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-grid me-2"></i>Dashboard
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link dn-nav-link" href="cars">
                        <i class="bi bi-car-front me-2"></i>Cars
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link dn-nav-link" href="bookings">
                        <i class="bi bi-calendar-check me-2"></i>Bookings
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link dn-nav-link" href="locations">
                        <i class="bi bi-geo-alt me-2"></i>Locations
                    </NavLink>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
                <ThemeToggle />
                <LoginDisplay />
            </div>
        </div>
    </div>
</nav>

@code {
    private bool menuOpen;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}